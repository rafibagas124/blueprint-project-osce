{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jalankan OSCE Center 3D (Chrome)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/blueprint.html"
    },
    {
      "name": "Jalankan OSCE Center 3D (Edge)",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/blueprint.html"
    },
    {
      "name": "Jalankan via Localhost (Port 8080)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/blueprint.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
