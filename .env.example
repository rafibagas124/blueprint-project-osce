# ============================================================================
# UKMPPAI OSCE 3D CENTER — ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env jika ingin kustomisasi environment lokal.
# ============================================================================
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Storage Driver (file | memory)
STORE_DRIVER=file

# Security & Authentication
JWT_SECRET=your-secret-jwt-signing-key-here-min-32-chars
SESSION_TTL_SECONDS=14400

# Proxy & Network Trust (true | false)
TRUST_PROXY=false

# Login Rate Limiting & Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=300000
LOCKOUT_GLOBAL_NIM_LIMIT=30
LOCKOUT_GLOBAL_NIM_WINDOW_MS=3600000

# Sharding & Multiplayer Capacity
MAX_CONCURRENT_STUDENTS=2000
ROOM_CAPACITY=10
SYNC_RATE_HZ=10

# AI Standardized Patient NPC Proxy (Backend-Only)
# Kosongkan API Key bila fitur AI tidak digunakan (akan fallback ke respons lokal)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_COST_PER_STUDENT_USD=0.15
AI_MAX_TURNS_PER_STATION=25

# Optional Distributed State & Persistence
# Kosongkan URL bila Redis/DB tidak digunakan (akan fallback ke FileStore lokal)
REDIS_URL=
DATABASE_URL=
AUTOSAVE_INTERVAL_MS=10000
