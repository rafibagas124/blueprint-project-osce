{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/[...path].js",
      "use": "@vercel/node"
    },
    {
      "src": "blueprint.html",
      "use": "@vercel/static"
    },
    {
      "src": "osce-preview.html",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    },
    {
      "src": "vendor/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api(/.*)?$",
      "dest": "/api/[...path].js"
    },
    {
      "src": "^/src(/.*)?$",
      "status": 404
    },
    {
      "src": "^/$",
      "dest": "/blueprint.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
